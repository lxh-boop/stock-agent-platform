# 复制为 deploy/server.env 并填写真实值。server.env 含密钥，不要提交到 git。

# ---- 端口与并发 ----
STOCK_APP_WEB_PORT=3000
STOCK_AGENT_MAX_CONCURRENT_TASKS=4
# 浏览器只通过前端 3000 端口访问（nginx 反代 /api/），此处填前端实际访问地址
STOCK_AGENT_CORS_ORIGINS=http://<服务器公网IP>:3000

# ---- 数据库密码（自己生成强密码，本地与服务器可以不同步）----
STOCK_POSTGRES_PASSWORD=换成强密码
NEO4J_PASSWORD=换成强密码

# ---- LLM：云服务器跑不了本地 ollama，必须用外部 OpenAI 兼容 API ----
# 示例（DeepSeek）：LLM_BASE_URL=https://api.deepseek.com/v1  LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat

# ---- 运行开关 ----
# 每日数据增量更新调度器：1=开。演示时段避开更新窗口
STOCK_APP_RUNTIME_SCHEDULER_ENABLED=1
# LLM prompt 全量 trace 很占磁盘，服务器上默认关
AGENT_FLOW_TRACE=0
