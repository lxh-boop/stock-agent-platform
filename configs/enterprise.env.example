# Enterprise E1 non-secret configuration example.
# Never put real credentials in this file if it is committed to Git.

STOCK_APP_ENV=development
STOCK_APP_DEPLOYMENT_MODE=compose-react
AGENT_API_HOST=0.0.0.0
AGENT_API_PORT=8010
AGENT_API_RELOAD=0
STOCK_AGENT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
STOCK_AGENT_RECOVER_INTERRUPTED_ON_START=1
STOCK_APP_RUNTIME_SCHEDULER_ENABLED=1
STOCK_APP_READINESS_CACHE_SECONDS=5

STOCK_AGENT_MAX_CONCURRENT_TASKS=4
AGENT_MAX_PARALLEL_REQUESTS=3
AGENT_MAX_PARALLEL_WORKERS=6
AGENT_MAX_PARALLEL_TOOLS=8
AGENT_MAX_PARALLEL_LLM=4

# Preferred production pattern: mount a secret file and provide its path.
# The file contents must contain only the secret value.
STOCK_LLM_API_KEY_FILE=
STOCK_TUSHARE_TOKEN_FILE=
STOCK_NEO4J_PASSWORD_FILE=
STOCK_POSTGRES_PASSWORD_FILE=

# Direct secret environment variables remain supported for compatibility,
# but *_FILE or an external secret manager is preferred.
# LLM_API_KEY=
# OPENAI_API_KEY=
# TUSHARE_TOKEN=
# NEO4J_PASSWORD=
# STOCK_POSTGRES_PASSWORD=

STOCK_POSTGRES_HOST=postgres
STOCK_POSTGRES_PORT=5432
STOCK_POSTGRES_DB=stock_daily_app
STOCK_POSTGRES_USER=stock_app
STOCK_POSTGRES_SCHEMA=stock_app
STOCK_POSTGRES_RUNTIME_SCHEMA=stock_runtime
STOCK_POSTGRES_CONNECT_TIMEOUT=8

NEO4J_URI=bolt://host.docker.internal:7687
NEO4J_USERNAME=neo4j
NEO4J_DATABASE=neo4j
NEO4J_CONNECTION_TIMEOUT_SECONDS=10
NEO4J_MAX_CONNECTION_POOL_SIZE=20
