# syntax=docker/dockerfile:1.7

FROM python:3.12-slim AS runtime-base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        libgomp1 \
        procps \
        tzdata \
    && rm -rf /var/lib/apt/lists/*

FROM runtime-base AS api-deps

ARG PIP_INDEX_URL=https://pypi.org/simple
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

# Keep the CPU PyTorch layer when only application requirements change.
# Cache downloads on the builder without copying them into the runtime image.
RUN --mount=type=cache,id=stock-api-pip,target=/root/.cache/pip,sharing=locked \
    unset PIP_NO_CACHE_DIR \
    && python -m pip install --upgrade pip --index-url "$PIP_INDEX_URL" \
    && python -m pip install torch --index-url "$TORCH_INDEX_URL"

COPY requirements-compose-api.txt ./
RUN --mount=type=cache,id=stock-api-pip,target=/root/.cache/pip,sharing=locked \
    unset PIP_NO_CACHE_DIR \
    && python -m pip install -r requirements-compose-api.txt --index-url "$PIP_INDEX_URL"

FROM runtime-base AS api

COPY --from=api-deps /usr/local /usr/local
COPY . /app
RUN mkdir -p /app/data /app/models /app/outputs /app/logs /app/runtime /app/external_repos

ENV AGENT_API_HOST=0.0.0.0 \
    AGENT_API_PORT=8010 \
    STOCK_APP_DEPLOYMENT_MODE=compose-react

EXPOSE 8010
CMD ["python", "-u", "run_agent_api.py"]
